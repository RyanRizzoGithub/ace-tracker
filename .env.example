# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; never commit real keys.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used by the extraction/save routes to write on the user's behalf.
# Keep this secret — it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (for PDF extraction) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- App ---
# Base URL used for auth email redirects. In local dev this is fine as-is.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
